# MCP Server Configuration Example
# Copy this file to mcp_servers.yml and customize

mcp_servers:
  # Example: Filesystem MCP server (Node.js)
  # Install: npm install -g @modelcontextprotocol/server-filesystem
  - name: filesystem
    command: node
    args:
      - "@modelcontextprotocol/server-filesystem/dist/index.js"
      - "/path/to/allowed/directory"
    transport: stdio
    permissions:
      read_file: filesystem.read
      write_file: filesystem.write
      list_directory: filesystem.read

  # Example: GitHub MCP server
  # Install: npm install -g @modelcontextprotocol/server-github
  - name: github
    command: node
    args:
      - "@modelcontextprotocol/server-github/dist/index.js"
    transport: stdio
    env:
      GITHUB_TOKEN: "${GITHUB_TOKEN}"  # Set in environment or .env
    permissions:
      search_repositories: github.read
      get_file_contents: github.read
      create_issue: github.write

  # Example: PostgreSQL MCP server (Python)
  # Install: pip install mcp-server-postgres
  - name: postgres
    command: python
    args:
      - "-m"
      - "mcp_server_postgres"
    transport: stdio
    env:
      DATABASE_URL: "postgresql://user:pass@localhost/dbname"
    permissions:
      query: database.read
      insert: database.write

# Permission format: [system].[resource].[action]
# Example permissions:
#   filesystem.read  - Read files/directories
#   filesystem.write - Write/modify files
#   github.read      - Read GitHub data
#   github.write     - Create/update GitHub entities
#   database.read    - Query database
#   database.write   - Insert/update data